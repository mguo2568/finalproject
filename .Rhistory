dat = read.csv("G:/My Drive/Harvard/Courses/Fall 2026/BST220 Applied Regression Methods/Homework/HW1 (cont.)/SCCS2_v12.csv", sep = ",", header = TRUE)
head(dat)
# or
# install.packages("haven")
# dat = haven::read_stata("SCCS2_v12.dta")
# Use female variable instead of gender
dat$female = dat$gender
dat$female[dat$gender == 1] = "Female"
dat$female[dat$gender == 0] = "Male"
dat$female = factor(dat$female, levels=c("Male", "Female"))
# the female variable contains genders in factor type
# Data Summary and Exploration
summary(dat)
# box plot
boxplot(weight ~ female, data = dat, ylab = "weight")
# scatter plots
plot(dat$age, dat$tc, main = "Relationship between total cholesterol and age")
pairs(~age + tc + weight, data = dat, main = "Relationship between total cholesterol, age and weight")
# A
age_in_decade = dat$age/10
# linear regression (age decade)
lm1A_d = lm(tc ~ age_in_decade, data = dat)
summary(lm1A_d)
confint(lm1A_d)
# linear regression (age)
lm1A = lm(tc ~ age, data = dat)
summary(lm1A)
# correlation
cor.test(age_in_decade, dat$tc)
# B
plot(lm1A)
# residuals
lm1A$residuals
# fitted.values
lm1A$fitted.values
# C
# scatter plot
plot(dat$age, dat$tc)
# loess curve
scatter.smooth(dat$age, dat$tc)
# include quadratic term
lm1C = lm(tc ~ age + I(age^2), data = dat)
summary(lm1C)
# A
# T-test
t.test(dat$tc ~ dat$female, var.equal = T)
lm2A = lm(tc ~ female, data = dat)
summary(lm2A)
confint(lm2A)
# B
# include quadratic term
lm2B = lm(tc ~ age + I(age^2) + female, data = dat)
summary(lm2B)
# C
# for each level of biological sex
plot(tc~age, data=dat, xlab="Age", ylab="Total Cholesterol")
curve(coef(lm2B)[1] + coef(lm2B)[2]*x + coef(lm2B)[3]*(x*x), add=T, col="blue", lwd=2)
curve(coef(lm2B)[1] + coef(lm2B)[2]*x + coef(lm2B)[3]*(x*x) + coef(lm2B)[4], add=T, col="pink", lwd=2)
legend('topleft',c("Male","Female"), col=c("blue","pink"),lty=c(1,1), cex=0.75)
# D
# include interaction
lm2D = lm(tc ~ age + I(age^2) + female + age * female + I(age^2) * female, data = dat)
summary(lm2D)
# D
# for each level of biological sex
plot(tc~age, data=dat, xlab="Age", ylab="Total Cholesterol")
curve(coef(lm2D)[1] + coef(lm2D)[2]*x + coef(lm2D)[3]*(x*x), add=T, col="blue", lwd=2)
curve(coef(lm2D)[1] + coef(lm2D)[2]*x + coef(lm2D)[3]*(x*x) + coef(lm2D)[4] + coef(lm2D)[5]*x + coef(lm2D)[6]*(x*x), add=T, col="pink", lwd=2)
legend('topleft',c("Male","Female"), col=c("blue","pink"),lty=c(1,1), cex=0.75)
# F
#sex=male
tc_male <- dat$tc[dat$female=="Male"]
age_male <- dat$age[dat$female=="Male"]
lm2_male = lm(tc_male ~ age_male + I(age_male^2), data = dat)
summary(lm2_male)
# F
#sex=female
tc_female <- dat$tc[dat$female=="Female"]
age_female <- dat$age[dat$female=="Female"]
lm2_female = lm(tc_female ~ age_female + I(age_female^2), data = dat)
summary(lm2_female)
# F
#plot
plot(dat$age, dat$tc, xlab="Age", ylab="Total Cholesterol")
curve(coef(lm2_male)[1] + coef(lm2_male)[2]*x + coef(lm2_male)[3]*(x*x), add=T, col="blue", lwd=2)
curve(coef(lm2_female)[1] + coef(lm2_female)[2]*x + coef(lm2_female)[3]*(x*x), add=T, col="pink", lwd=2)
legend('topleft',c("Male","Female"), col=c("blue","pink"),lty=c(1,1), cex=0.75)
dat$bmi <- dat$weight/(dat$height/100)^2
dat = dat[order(dat$bmi),]
# Generate bmicat
dat$bmicat[(dat$bmi>=18.5 & dat$bmi<25)] = 0
dat$bmicat[(dat$bmi<18.5)] = 1
dat$bmicat[(dat$bmi>=25 & dat$bmi<30)] = 2
dat$bmicat[(dat$bmi>=30)] = 3
dat$bmicat = as.factor(dat$bmicat)
# Fit the model with continuous BMI
lm3_bmi_cont <- lm(tc~bmi, data=dat)
summary(lm3_bmi_cont)
# Fit the model with categorical BMI
lm3_bmi_cat <- lm(tc~bmicat, data=dat)
summary(lm3_bmi_cat)
anova(lm3_bmi_cat)
par(mfrow=c(1,1))
plot(tc~bmi, xlab="BMI", ylab="Total Cholesterol", data=dat)
lines(dat$bmi, fitted(lm3_bmi_cont), col=2, lwd=2)
lines(dat$bmi, fitted(lm3_bmi_cat), col=3, lwd=2)
legend('topleft',lty=1,lwd=2,col=2:3,legend=c('continuous','categorical'))
par(mfrow=c(1,1))
plot(tc~bmi, xlab="BMI", ylab="Total Cholesterol", data=dat)
lines(dat$bmi, fitted(lm3_bmi_cont), col=2, lwd=2)
legend('topleft',lty=1,lwd=2,col=2,legend=c('continuous'))
par(mfrow=c(1,1))
plot(tc~bmi, xlab="BMI", ylab="Total Cholesterol", data=dat)
lines(dat$bmi, fitted(lm3_bmi_cat), col=3, lwd=2)
legend('topleft',lty=1,lwd=2,col=3,legend=c('categorical'))
# Fit the model with continuous BMI & BMI squared
lm3_bmi_cont_2 <- lm(tc ~ bmi + I(bmi^2), data=dat)
summary(lm3_bmi_cont_2)
# D
# include interaction
lm2_all = lm(tc ~ age + I(age^2) + female + age * female + I(age^2) * female + bmi + I(bmi^2), data = dat)
summary(lm2_all)
plot(lm2_all)
# residuals
lm2_all$residuals
# fitted.values
lm2_all$fitted.values
# D
# for influential points and outliers
tc_cook <- dat$tc[cooks.distance(lm2_all)<(4/525*2)]
age_cook <- dat$age[cooks.distance(lm2_all)<(4/525*2)]
female_cook <- dat$female[cooks.distance(lm2_all)<(4/525*2)]
bmi_cook <- dat$bmi[cooks.distance(lm2_all)<(4/525*2)]
lm2_cook = lm(tc_cook ~ age_cook + I(age_cook^2) + female_cook + age_cook * female_cook + I(age_cook^2) * female_cook + bmi_cook + I(bmi_cook^2))
summary(lm2_cook)
length(tc_cook)
length(age_cook)
length(female_cook)
length(bmi_cook)
# D
# for influential points and outliers
length(dffits(lm2_cook)[abs(dffits(lm2_cook)) > (2*sqrt(8/527))])
length(dfbetas(lm2_cook)[abs(dfbetas(lm2_cook)) > (2/sqrt(527))])
anova(bmicat, tc)
